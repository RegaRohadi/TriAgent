APP_PORT=8000
SCRAPER_PORT=8002
CHAT_PORT=8001

# --- LLM -------------------------------------------------------------------
# Fill ONE provider API key below. TriAgent auto-detects the provider from
# whichever key is filled. If you want more than one provider, set
# LLM_PROVIDER explicitly (or use LLM_FALLBACK_PROVIDERS).
#
# The real .env is ignored by git. This file is the safe template.

# DeepSeek (default example)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# DEEPSEEK_MODEL_FALLBACKS=deepseek-v4-pro

# OpenAI
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini

# Anthropic Claude
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-5

# Google Gemini (OpenAI-compatible endpoint)
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash

# OpenRouter: one key for many models
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=

# Groq
# GROQ_API_KEY=
# GROQ_MODEL=

# Mistral
# MISTRAL_API_KEY=
# MISTRAL_MODEL=mistral-small-latest

# Together AI / Fireworks AI
# TOGETHER_API_KEY=
# TOGETHER_MODEL=
# FIREWORKS_API_KEY=
# FIREWORKS_MODEL=

# Local OpenAI-compatible servers (no API key)
# Set LLM_PROVIDER=ollama below and fill OLLAMA_MODEL.
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=

# Any other OpenAI-compatible endpoint
# Set LLM_PROVIDER=custom below and fill LLM_API_KEY / LLM_BASE_URL / LLM_MODEL.
# LLM_API_KEY=
# LLM_BASE_URL=
# LLM_MODEL=

# auto = use the only provider key that is filled; mock = deterministic fake.
LLM_PROVIDER=auto

# Optional overrides
# LLM_MODEL=
# LLM_MODEL_FALLBACKS=
# LLM_FALLBACK_PROVIDERS=openai,anthropic
# LLM_TIMEOUT=120
# LLM_MAX_TOKENS=8192
# LLM_STRUCTURED_MODE=auto
# LLM_TEMPERATURE=0
# LLM_PACING_SECONDS=0

EMBEDDING_BACKEND=sentence-transformers
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

SEMANTIC_PRECHECK_THRESHOLD=0.45
RETRIEVAL_MIN_SCORE=0.30
RETRIEVAL_TOP_K=8
CLASSIFICATION_CONFIDENCE_THRESHOLD=0.6
REFUND_AMOUNT_THRESHOLD_USD=500
REFUND_AGE_DAYS_THRESHOLD=90
CONTACT_FREQUENCY_THRESHOLD=3
CONTACT_FREQUENCY_WINDOW_DAYS=7
MAX_REDRAFT_ATTEMPTS=1

MAX_MESSAGE_ATTEMPTS=3
MESSAGE_CLAIM_TTL_SECONDS=600

LOG_JSON=false
LOG_LEVEL=INFO

SCRAPER_CAMOUFOX_ENABLED=
SCRAPER_CAMOUFOX_TIMEOUT=30

IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX

POLL_ENABLED=false
POLL_INTERVAL_SECONDS=60
POLL_BATCH_SIZE=10

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=Nimbus Support

MEMORY_WINDOW_TURNS=6
MEMORY_MAX_FACTS=25
CHAT_RETRIEVAL_TOP_K=6
CHAT_RETRIEVAL_MIN_SCORE=0.25
